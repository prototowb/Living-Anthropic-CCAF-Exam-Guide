{
  "name": "claude-code-companion",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "Interactive study companion for Claude Code (the CLI tool), aimed at beginner users. Living-codebase derivative of architect-interactive-playbook — the source is itself a reference implementation of all 6 Architect — Foundations exam scenarios.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && node scripts/check-bundle-size.js",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "extract": "tsx scripts/extract/extract.ts",
    "extract:edges": "tsx scripts/extract/edges.ts",
    "extract:probe": "tsx scripts/extract/probe.ts",
    "review:dry": "tsx scripts/review-pr.ts",
    "check:agent-imports": "tsx scripts/check-agent-imports.ts",
    "check:claude-md": "tsx scripts/check-claude-md.ts",
    "eval:helpbot": "tsx --tsconfig tsconfig.app.json scripts/eval-helpbot.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@mlc-ai/web-llm": "^0.2.84",
    "pinia": "^2.2.4",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "ajv": "^8.17.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sass": "^1.81.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
}
