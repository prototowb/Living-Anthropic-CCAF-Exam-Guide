{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(**)",
      "Grep(**)",
      "Glob(**)",
      "Edit(src/**)",
      "Edit(scripts/**)",
      "Edit(docs/**)",
      "Edit(.claude/**)",
      "Edit(CLAUDE.md)",
      "Edit(PROJECT_PLAN.md)",
      "Write(src/**)",
      "Write(scripts/**)",
      "Write(docs/**)",
      "Write(.claude/**)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run extract)",
      "Bash(npm run dev)",
      "Bash(git status)",
      "Bash(git status --short:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(cat:*)"
    ],
    "deny": [
      "Edit(src/data/_generated/**)",
      "Edit(docs/extraction-sources/**)",
      "Edit(package-lock.json)",
      "Edit(node_modules/**)",
      "Write(src/data/_generated/**)",
      "Write(docs/extraction-sources/**)",
      "Bash(rm *)",
      "Bash(rm -rf *)",
      "Bash(git push *)",
      "Bash(git push:*)",
      "Bash(git reset --hard *)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(npm publish *)",
      "WebFetch(*)"
    ]
  },
  "hooks": {
    "preToolUse": [
      {
        "matcher": { "tool": "Edit" },
        "command": ".claude/hooks/scope-guard.sh"
      },
      {
        "matcher": { "tool": "Write" },
        "command": ".claude/hooks/scope-guard.sh"
      }
    ]
  }
}
